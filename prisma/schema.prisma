// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id        String   @id
  username  String   @unique
  avatarUrl String?  @map("avatar_url")
  coverUrl  String?  @map("cover_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("user_profiles")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id")
  title     String
  body      String
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  postTags PostTag[]
  comments Comment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model Tag {
  slug        String   @id
  label       String
  description String   @default("")
  hashColor   String   @map("hash_color")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  postTags     PostTag[]
  memberships CommunityMembership[]

  @@map("tags")
}

model CommunityMembership {
  userId       String   @map("user_id")
  communitySlug String  @map("community_slug")
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  community Tag @relation(fields: [communitySlug], references: [slug], onDelete: Cascade)

  @@id([userId, communitySlug])
  @@index([communitySlug, joinedAt])
  @@map("community_memberships")
}

model PostTag {
  postId  String @map("post_id") @db.Uuid
  tagSlug String @map("tag_slug")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagSlug], references: [slug])

  @@id([postId, tagSlug])
  @@index([tagSlug, postId])
  @@map("post_tags")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@map("comments")
}

model Vote {
  userId     String @map("user_id")
  targetType String @map("target_type")
  targetId   String @map("target_id") @db.Uuid
  value      Int    @db.SmallInt

  @@id([userId, targetType, targetId]) // basically just a unique ID for each vote
  @@index([targetType, targetId])
  @@map("votes")
}
