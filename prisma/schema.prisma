// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id          String   @id
  userName    String   @unique @map("username")
  displayName String?  @map("display_name")
  bio         String?  @map("bio")
  avatarUrl   String?  @map("avatar_url")
  coverUrl    String?  @map("cover_url")
  email       String   @map("email")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  chatParticipations ChatParticipant[]
  chatMessages       ChatMessage[]

  @@map("users")
}

model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userID, createdAt])
  @@map("backup_codes")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorID  String   @map("author_id")
  title     String
  body      String
  imageUrls String[] @default([]) @map("image_urls")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  postTags PostTag[]
  comments Comment[]

  @@index([createdAt])
  @@index([authorID, createdAt])
  @@map("posts")
}

model Community {
  slug        String   @id
  label       String
  description String   @default("")
  hashColor   String   @map("hash_color")
  avatarUrl   String?  @map("avatar_url")
  coverUrl    String?  @map("cover_url")
  createdByID String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  postTags    PostTag[]
  memberships CommunityMembers[]
  chatRooms   ChatConversation[]

  @@map("community")
}

model CommunityMembers {
  userID        String   @map("user_id")
  communitySlug String   @map("community_slug")
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  community Community @relation(fields: [communitySlug], references: [slug], onDelete: Cascade)

  @@id([userID, communitySlug])
  @@index([communitySlug, joinedAt])
  @@map("community_members")
}

model PostTag {
  postID  String @map("post_id") @db.Uuid
  tagSlug String @map("tag_slug")

  post Post      @relation(fields: [postID], references: [id], onDelete: Cascade)
  tag  Community @relation(fields: [tagSlug], references: [slug])

  @@id([postID, tagSlug])
  @@index([tagSlug, postID])
  @@map("post_tags")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postID    String   @map("post_id") @db.Uuid
  authorID  String   @map("author_id")
  parentID  String?  @map("parent_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postID], references: [id], onDelete: Cascade)

  @@index([postID, createdAt])
  @@index([authorID, createdAt])
  @@map("comments")
}

model Vote {
  userID     String @map("user_id")
  targetType String @map("target_type")
  targetID   String @map("target_id") @db.Uuid
  value      Int    @db.SmallInt

  @@id([userID, targetType, targetID]) // basically just a unique ID for each vote
  @@index([targetType, targetID])
  @@map("votes")
}

model ChatConversation {
  id            String   @id @default(uuid()) @db.Uuid
  type          String
  communitySlug String?  @unique @map("community_slug")
  directKey     String?  @unique @map("direct_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  community    Community?        @relation(fields: [communitySlug], references: [slug], onDelete: Cascade)
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([type, updatedAt])
  @@map("chat_conversations")
}

model ChatParticipant {
  conversationID String    @map("conversation_id") @db.Uuid
  userID         String    @map("user_id")
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation ChatConversation @relation(fields: [conversationID], references: [id], onDelete: Cascade)
  user         Users            @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@id([conversationID, userID])
  @@index([userID, createdAt])
  @@map("chat_participants")
}

model ChatMessage {
  id             String    @id @default(uuid()) @db.Uuid
  conversationID String    @map("conversation_id") @db.Uuid
  authorID       String    @map("author_id")
  body           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  conversation ChatConversation @relation(fields: [conversationID], references: [id], onDelete: Cascade)
  author       Users            @relation(fields: [authorID], references: [id], onDelete: Cascade)

  @@index([conversationID, createdAt])
  @@index([authorID, createdAt])
  @@map("chat_messages")
}
