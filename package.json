{
  "name": "celestia",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "npm i && prisma generate && next dev",
    "build": "npm i && npm run db:push && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push && prisma generate",
    "db:reset": "tsx scripts/confirm-db-reset.ts && prisma migrate reset --force && tsx scripts/reset-supabase-auth.ts && tsx scripts/empty-supabase-storage.ts",
    "supabase:storage": "tsx scripts/setup-supabase-storage.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "sass": "^1.101.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
